# Table Oracle needs exactly one key.
#
# Claude answers the questions. Retrieval runs on a local embedding model
# (bge-small-en-v1.5, ~67MB, downloaded once on first ingest), so embeddings
# cost nothing and need no account.
ANTHROPIC_API_KEY=sk-ant-...

# --- optional overrides (defaults shown) ---
# TABLEORACLE_ANSWER_MODEL=claude-opus-5
# TABLEORACLE_ANSWER_EFFORT=medium
# TABLEORACLE_TOP_K=5
# TABLEORACLE_DB_PATH=data/tableoracle.db

# --- optional: hosted embeddings instead of the local model ---
# Anthropic has no embeddings endpoint, so these are third-party. The local
# default is usually the better trade; these exist because the provider is
# swappable (see tableoracle/ingest/embed.py).
# TABLEORACLE_EMBED_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...
