# Table Oracle needs two keys: Anthropic for answering, OpenAI for embeddings.
# (Anthropic does not ship an embeddings endpoint; see README "Two keys".)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# TABLEORACLE_ANSWER_MODEL=claude-opus-5
# TABLEORACLE_ANSWER_EFFORT=medium
# TABLEORACLE_EMBED_MODEL=text-embedding-3-small
# TABLEORACLE_DB_PATH=data/tableoracle.db
# TABLEORACLE_TOP_K=5
